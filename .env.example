# DRISHTI Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

APP_NAME=DRISHTI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Security (Generate a secure secret using: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (PostgreSQL with PostGIS and pgvector)
POSTGRES_DB=drishti
POSTGRES_USER=drishti
POSTGRES_PASSWORD=drishti_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://drishti:drishti_dev_password@localhost:5432/drishti

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage Abstraction
STORAGE_BACKEND=local
DATA_ROOT=./data
IMAGERY_ROOT=./data/imagery
TILE_ROOT=./data/tiles
THUMBNAIL_ROOT=./data/thumbnails
MODEL_ROOT=./data/models
EXPORT_ROOT=./data/exports
LOCAL_BASEMAP_ROOT=./data/local_basemaps

# Vector and Model Execution
VECTOR_BACKEND=pgvector
EMBEDDING_DEVICE=cpu
VECTOR_DIMENSION_CLIP=768
VECTOR_DIMENSION_DINO=768

REMOTECLIP_MODEL_PATH=./data/models/remoteclip
DINOV2_MODEL_PATH=./data/models/dinov2
CHANGE_MODEL_PATH=./data/models/change_detection

# Network & Ingestion
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=2048

# Offline Operation Guard
OFFLINE_MODE=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
